# gitlab-runner config.toml - generated by the gitlab-runner-fargate module.
# Do not edit on the container; it is rewritten from the task definition on every
# task start.
#
# Every caller-supplied string below goes through jsonencode(). Numbers and bools
# interpolate raw because Terraform's type system guarantees they cannot carry a
# newline or a metacharacter, and each one is listed in tests/template_safety.py
# with its variable name so the claim is checked against variables.tf, not
# asserted here (R1, R2.3).
#
# Unlike the EC2 sibling, this file is NOT transported through a shell heredoc.
# It travels as a base64-encoded environment variable and is decoded to disk by
# an entrypoint that ships in the image. So a newline in a value here cannot
# become shell - there is no shell in the path.

concurrent = ${manager_concurrent}
check_interval = ${manager_check_interval}
log_format = "json"

# LOAD-BEARING, not telemetry. GitLab Runner starts its Prometheus/health HTTP
# server ONLY when listen_address is set - the documented default is "not
# defined" - and the manager container's ECS health check probes exactly this
# address. Omit it and the probe can never succeed: ECS marks the container
# UNHEALTHY, replaces the task forever, the service never reaches steady state,
# and `terraform apply` fails on wait_for_steady_state.
#
# The health-check command is derived from the SAME variable in locals.tf, so the
# two cannot drift. tests/parse_config.py asserts both that this key exists and
# that its port matches the probe.
listen_address = ${jsonencode(listen_address)}

# NOTE: no [session_server] block. It requires its own listen_address and an
# advertised address reachable from GitLab, which a manager with no inbound
# security-group rules cannot provide. An inert block would read as a working
# feature (R5), so it is absent rather than decorative.

[[runners]]
  name = ${jsonencode(runner_name)}
  url = ${jsonencode(gitlab_url)}
  # Substituted from the Secrets Manager value by the entrypoint, via stdin.
  # The literal token never appears in this file, in the task definition, or in
  # Terraform state.
  token = "RUNNER_TOKEN_PLACEHOLDER"
  executor = "custom"
  limit = ${manager_concurrent}
  request_concurrency = ${manager_request_concurrency}
%{ if clone_url != "" ~}
  # The URL handed to jobs for `git clone`, when GitLab's API URL is not what the
  # fleet can reach - the usual isolated-estate case.
  clone_url = ${jsonencode(clone_url)}
%{ endif ~}
%{ if tls_ca_file != "" ~}
  # Private CA for a self-managed GitLab. Points at the writable config volume;
  # the entrypoint decodes the bundle there.
  tls-ca-file = ${jsonencode(tls_ca_file)}
%{ endif ~}

  # Paths INSIDE the job container, not on the manager.
  builds_dir = "/opt/gitlab-runner/builds"
  cache_dir = "/opt/gitlab-runner/cache"

  [runners.custom]
    config_exec = ${jsonencode(driver_path)}
    config_args = [${jsonencode(driver_config_flag)}, ${jsonencode(driver_config_path)}, "custom", "config"]
    prepare_exec = ${jsonencode(driver_path)}
    prepare_args = [${jsonencode(driver_config_flag)}, ${jsonencode(driver_config_path)}, "custom", "prepare"]
    run_exec = ${jsonencode(driver_path)}
    run_args = [${jsonencode(driver_config_flag)}, ${jsonencode(driver_config_path)}, "custom", "run"]
    cleanup_exec = ${jsonencode(driver_path)}
    cleanup_args = [${jsonencode(driver_config_flag)}, ${jsonencode(driver_config_path)}, "custom", "cleanup"]

    # prepare has to cover a cold Fargate task: RunTask, then the image pull
    # (which is also when billing starts), then sshd coming up. The driver's own
    # waiter ceiling is set in fargate.toml; this is the runner's patience for
    # the whole prepare stage and must exceed it or the runner gives up first.
    prepare_exec_timeout = ${prepare_exec_timeout}
    cleanup_exec_timeout = 300
    graceful_kill_timeout = 300
    force_kill_timeout = 60

%{ if cache_enabled ~}
  # Distributed cache. Not optional in practice: job tasks are ephemeral, so
  # cache_dir alone does nothing between jobs.
  #
  # AuthenticationType = "iam" picks up the manager task role - no static keys.
  # Job containers need no S3 permissions at all: the manager mints time-limited
  # pre-signed URLs and hands those to the job.
  [runners.cache]
    Type = "s3"
    Shared = true
%{ if cache_path != "" ~}
    Path = ${jsonencode(cache_path)}
%{ endif ~}

    [runners.cache.s3]
      BucketName = ${jsonencode(cache_bucket)}
      BucketLocation = ${jsonencode(cache_region)}
      AuthenticationType = "iam"
%{ if cache_sse != "" ~}
      ServerSideEncryption = ${jsonencode(cache_sse)}
%{ endif ~}
%{ if cache_kms_key_arn != "" ~}
      ServerSideEncryptionKeyID = ${jsonencode(cache_kms_key_arn)}
%{ endif ~}
%{ endif ~}
