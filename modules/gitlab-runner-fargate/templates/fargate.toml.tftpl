# Fargate custom-executor driver config - generated by the gitlab-runner-fargate
# module. Same encoding discipline as config.toml: every caller string through
# jsonencode(), numbers and bools raw and justified in tests/template_safety.py.
#
# NOTE ON KEY NAMES: the driver's Go struct fields are Subnet and SecurityGroup,
# SINGULAR. The driver's own shipped config.toml.example uses "Subnets" and
# "SecurityGroups", which are silently ignored and produce a startup failure
# complaining that no security group was specified. tests/parse_config.py asserts
# the singular forms so this cannot regress.

LogLevel = ${jsonencode(log_level)}
LogFormat = "json"

[Fargate]
  Cluster = ${jsonencode(cluster)}
  Region = ${jsonencode(region)}
  Subnet = ${jsonencode(subnets)}
  SecurityGroup = ${jsonencode(security_group)}
  TaskDefinition = ${jsonencode(task_definition)}

  # Job tasks get no public IP. They reach the internet through the NAT gateway
  # or egress proxy in their subnets. EnablePublicIP = false with
  # UsePublicIP = true is rejected by the driver at startup; both false means the
  # manager connects to the task's private IPv4, which is the only mode where the
  # job security group's SG-to-SG rule is meaningful.
  EnablePublicIP = false
  UsePublicIP = false

  # Off by default and it should stay off: ECS Exec runs commands as root inside a
  # container executing untrusted CI code, forces a task role to exist, needs the
  # ssmmessages endpoint, and cannot coexist with a read-only root filesystem.
  # The driver's own documentation recommends against leaving it enabled.
  EnableExecuteCommand = ${job_enable_execute_command}

  # Tags come from the task definition only - the driver never sets per-task tags,
  # so a job cannot be attributed to a project this way. See the FinOps note in
  # the README: use STS session tags plus CloudTrail instead.
  PropagateTags = true

%{ if evaluate_task_health ~}
  # The default profile declares a health check, so wait for HEALTHY rather than
  # merely RUNNING. Without this the driver SSHes the moment the task is RUNNING,
  # which on a slow image means it races sshd and burns its retry budget.
  EvaluateTaskHealth = true

  [Fargate.TaskHealthWaitConfig]
    Retries = 3
    CheckInterval = "30s"
%{ else ~}
  EvaluateTaskHealth = false
%{ endif ~}

  # MaxAttempts * WaitTimeout is the ceiling on waiting for a job task to reach
  # RUNNING. Billing starts at image pull, not at RUNNING, so a fat image spends
  # this budget and charges for it. Keep config.toml's prepare_exec_timeout above
  # the product or the runner abandons the job before the driver does.
  [Fargate.TaskWaitConfig]
    MaxAttempts = ${job_task_wait_max_attempts}
    WaitTimeout = ${job_task_wait_interval}

[TaskMetadata]
  # prepare, run and cleanup are SEPARATE process invocations. prepare writes the
  # task ARN, the container IP and the per-job SSH private key here at mode 0600,
  # and run/cleanup read them back. It therefore has to persist across processes
  # within one container - which is why the manager is a single container per
  # runner and why you scale by adding managers, not by raising desired_count.
  Directory = ${jsonencode(metadata_directory)}

[SSH]
  Username = ${jsonencode(ssh_username)}
  Port = 22
