      "object-locator": { "schema-name": "%", "table-name": "%" },
      "rule-action": "convert-lowercase"
    },
    {
      "rule-type": "transformation",
      "rule-id": "4",
      "rule-name": "lowercase-column",
      "rule-target": "column",
      "object-locator": { "schema-name": "%", "table-name": "%", "column-name": "%" },
      "rule-action": "convert-lowercase"
