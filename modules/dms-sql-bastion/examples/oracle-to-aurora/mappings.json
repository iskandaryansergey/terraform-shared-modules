{
  "rules": [
    {
      "rule-type": "selection",
      "rule-id": "1",
      "rule-name": "core",
      "object-locator": { "schema-name": "CORE", "table-name": "%" },
      "rule-action": "include"
    },
    {
      "rule-type": "transformation",
      "rule-id": "2",
      "rule-name": "lowercase-schema",
      "rule-target": "schema",
      "object-locator": { "schema-name": "%" },
      "rule-action": "convert-lowercase"
    },
    {
      "rule-type": "transformation",
      "rule-id": "3",
      "rule-name": "lowercase-table",
