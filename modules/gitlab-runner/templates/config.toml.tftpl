# Generated by Terraform (module: gitlab-runner). Edits here are lost on the next
# manager boot; change the module inputs instead.
#
# All caller strings go through jsonencode(). This file travels inside a shell
# heredoc, so a raw interpolation could emit a newline and break out of it.

concurrent = ${concurrent}
check_interval = 3
log_format = "json"
listen_address = ${jsonencode(metrics_listen)}

[[runners]]
  name = ${jsonencode(name)}
  url = ${jsonencode(gitlab_url)}
  token = "RUNNER_TOKEN_PLACEHOLDER"
  executor = "docker-autoscaler"
%{ if length(runner_environment) > 0 ~}
  environment = ${jsonencode(runner_environment)}
%{ endif ~}

  # Docker executor, as it runs on each worker.
  [runners.docker]
    image = ${jsonencode(docker_image)}
    privileged = ${docker_privileged}
    volumes = ${jsonencode(docker_volumes)}
%{ if length(allowed_images) > 0 ~}
    allowed_images = ${jsonencode(allowed_images)}
%{ endif ~}
%{ if length(allowed_services) > 0 ~}
    allowed_services = ${jsonencode(allowed_services)}
%{ endif ~}

  [runners.autoscaler]
    plugin = ${jsonencode(plugin)}

    # capacity_per_instance x max_instances = total job slots.
    capacity_per_instance = ${capacity_per_instance}
    max_use_count = ${max_use_count}
    max_instances = ${max_instances}
%{ if ready_command != "" ~}

    # Keep this above the sub-tables. TOML binds a bare key to the last table
    # opened, so moving it down attaches it to a sub-table and the gate never
    # runs. Without the gate the plugin dispatches as soon as sshd answers,
    # which on a cold worker is before Docker is up.
    instance_ready_command = ${jsonencode(ready_command)}
%{ endif ~}
%{ if scale_throttle.limit > 0 || scale_throttle.burst > 0 ~}

    # Stops a big pipeline stampeding the EC2 API.
    [runners.autoscaler.scale_throttle]
      limit = ${scale_throttle.limit}
      burst = ${scale_throttle.burst}
%{ endif ~}

    # Credentials come from the manager's instance role.
    [runners.autoscaler.plugin_config]
      name = ${jsonencode(asg_name)}

    # SSH to the worker's private address with a short-lived key from EC2
    # Instance Connect. No keypair to manage.
    [runners.autoscaler.connector_config]
      username = ${jsonencode(ssh_username)}
      use_external_addr = false
      timeout = "5m0s"
%{ for p in policies ~}

    [[runners.autoscaler.policy]]
      idle_count = ${p.idle_count}
      idle_time = ${jsonencode(p.idle_time)}
      periods = ${jsonencode(p.periods)}
      timezone = ${jsonencode(p.timezone)}
%{ if p.scale_factor > 0 ~}
      scale_factor = ${p.scale_factor}
%{ endif ~}
%{ if p.scale_factor_limit > 0 ~}
      scale_factor_limit = ${p.scale_factor_limit}
%{ endif ~}
%{ endfor ~}
%{ if extra_config != "" ~}

# extra_runner_config_toml, appended verbatim. Table headers here are absolute
# paths. A validation requires the value to open a table, because a bare key
# would bind to the last policy above and corrupt it.
${extra_config}
%{ endif ~}
